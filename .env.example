# TradingAgents 本地运行配置示例 —— 复制为 .env 后填入你自己的 Key
# cp .env.example .env

# ① LLM Provider（默认 DeepSeek，性价比高、中文好；也可换 openai / anthropic 等）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-chat
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat

# ② 报告输出语言：Chinese / English（内部辩论固定用英文以保证推理质量）
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# ③ 控制成本/时长：多空辩论与风险辩论各几轮（1 即可跑通，调大更充分）
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
